# Copy this file to .env, replace the password placeholder, and keep .env local:
#   Copy-Item .env.example .env

# KFC_PUBLIC_PORT is the only Windows host port published by Compose.
KFC_PUBLIC_PORT=8080

# KFC_SERVER_PORT is the private game-server container port. Keep it at 8080
# because the validated image health check probes internal port 8080.
KFC_SERVER_PORT=8080

# KFC_SERVER_BIND_ADDRESS is the private listener address inside the container.
KFC_SERVER_BIND_ADDRESS=0.0.0.0

# Docker Compose uses PostgreSQL. PostgreSQL and game-server ports stay private.
KFC_DATABASE_TYPE=postgresql
KFC_POSTGRES_HOST=postgres
KFC_POSTGRES_PORT=5432
KFC_POSTGRES_DATABASE=kungfu_chess
KFC_POSTGRES_ADMIN_USER=kfc_admin
KFC_POSTGRES_USER=kfc

# Development placeholders only. Use two different passwords and replace both
# in the untracked .env file. The game server receives only the application one.
KFC_POSTGRES_ADMIN_PASSWORD=replace-with-a-local-admin-password
KFC_POSTGRES_PASSWORD=replace-with-a-local-application-password

# Native/local execution defaults to SQLite when KFC_DATABASE_TYPE is omitted.
KFC_DATABASE_PATH=kungfu_chess.db

# Do not place credentials or production secrets in this example file.
