# KFC_PUBLIC_PORT is the Windows host port published by NGINX.
KFC_PUBLIC_PORT=8080

# KFC_SERVER_PORT is the private game-server container port. Keep it at 8080
# because the validated image health check probes internal port 8080.
KFC_SERVER_PORT=8080

# KFC_SERVER_BIND_ADDRESS is the private listener address inside the container.
KFC_SERVER_BIND_ADDRESS=0.0.0.0

# KFC_DATABASE_PATH is inside the game-server container and its /data volume.
KFC_DATABASE_PATH=/data/kungfu_chess.db

# Do not place credentials or production secrets in this example file.
